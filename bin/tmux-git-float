#!/usr/bin/env bash
# tmux-git-float — floating-pane variant (like the tmux-notify toast).
#
# Orchestrator. Runs under `run-shell` (no TTY): it only computes the geometry
# and creates the floating pane with `new-pane` (same primitive as
# tmux-notify-popup). A float can't be split, so the multi-pane dashboard lives
# in a NESTED tmux launched inside the float (see tmux-git-nested).
#
#
# Injected by the keybinding: TMUX_GIT_DIR = the active pane's directory.
set -euo pipefail

BIN="$HOME/.env/.tmux.conf/bin"

cd "${TMUX_GIT_DIR:-$PWD}" 2>/dev/null || true

if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  tmux display-message "tmux-git: not a git repository"
  exit 0
fi

root=$(git rev-parse --show-toplevel)

# Geometry: float centered at 85% of the window. In new-pane, -x/-y are the SIZE
# and -X/-Y the POSITION (the opposite of display-popup).
read -r ww wh win < <(tmux display -p '#{window_width} #{window_height} #{session_name}:#{window_index}')
w=$(( ww * 85 / 100 ))
h=$(( wh * 85 / 100 ))
x=$(( (ww - w) / 2 ))
y=$(( (wh - h) / 2 ))

# Auto-lock the OUTER tmux while the float is open, mirroring its C-Space lock:
# prefix -> None so a C-b passes through to the float and drives the git panes
# (prefix2). Target the session explicitly (-t) and stash its name in a global
# flag so the nested cleanup can unlock exactly this session — and only if WE
# locked it (a pre-existing manual lock is left as it was).
if [ "$(tmux show -gv key-table 2>/dev/null)" != off ]; then
  sess=$(tmux display -p '#{session_name}')
  tmux set -g @git-autolock "$sess" \; \
      set -t "$sess" prefix None \; \
      set -t "$sess" key-table off \; \
      set -t "$sess" status-style 'bg=colour52,fg=colour255' \; \
      refresh-client -S
fi

# TMUX_OUTER lets the nested C-z (tmux-git-zoom) grow THIS float — a pane in the
# outer server — when zooming. It's the outer's socket,pid,session triple.
tmux new-pane -t "$win" -c "$root" -e GIT_ROOT="$root" -e TMUX_OUTER="$TMUX" \
  -B heavy -T ' git ' \
  -x "$w" -y "$h" -X "$x" -Y "$y" \
  "$BIN/tmux-git-nested"
