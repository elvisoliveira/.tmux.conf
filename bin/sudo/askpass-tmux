#!/usr/bin/env bash
# SUDO_ASKPASS: asks for the password in a tmux popup (display-popup), on
# demand — no resident agent. Shows the real sudo command (read from /proc of
# the parent process). The password goes to sudo over a 0600 FIFO in tmpfs.
# Fallback: sudo-tty-agent (if running); otherwise fails with a warning.
set -u
CMD=$(tr '\0' ' ' < /proc/$PPID/cmdline 2>/dev/null | tr -d '\n')
RT=${XDG_RUNTIME_DIR:-/run/user/$(id -u)}

# Justification self-declared by the agent in $RT/sudo-reason (consumed once;
# ignored if older than 60s, so a leftover from an old invocation is never shown).
# NOT verified — the authoritative line is always the command read from /proc.
REASON=
if [ -f "$RT/sudo-reason" ]; then
    mt=$(stat -c %Y "$RT/sudo-reason" 2>/dev/null || echo 0)
    [ $(( $(date +%s) - mt )) -le 60 ] && REASON=$(head -c 600 "$RT/sudo-reason" | head -n 8)
    rm -f "$RT/sudo-reason"
fi

# The most recently active tmux client gets the popup
client=$(tmux list-clients -F '#{client_activity} #{client_name}' 2>/dev/null \
         | sort -rn | awk 'NR==1{print $2}')

if [ -n "$client" ]; then
    D=$(mktemp -d "$RT/sudo-ask.XXXXXX") || exit 1
    mkfifo -m600 "$D/pass" || { rm -rf "$D"; exit 1; }
    trap 'rm -rf "$D"' EXIT
    printf '%s' "${CMD:-unknown command}" > "$D/cmd"
    printf '%s' "$REASON" > "$D/reason"
    # The command travels by file (no interpolating content into shell); the
    # prompt.sh never contains the password. Command first (authoritative),
    # justification after, already truncated — so it can't push the command
    # off the screen.
    cat > "$D/prompt.sh" <<EOP
#!/bin/sh
printf '\\033[1mAuthorizing execution of:\\033[0m\n\n    %s\n\n' "\$(cat '$D/cmd')"
if [ -s '$D/reason' ]; then
    printf '\\033[2mJustification (self-declared by the agent, not verified):\\033[0m\n'
    sed 's/^/    /' '$D/reason'
    printf '\n\n'
fi
printf 'Password (Esc cancels): '
stty -echo 2>/dev/null
IFS= read -r p
stty echo 2>/dev/null
printf '\n'
printf '%s\n' "\$p" > '$D/pass'
EOP
    tmux display-popup -c "$client" -T ' sudo ' -w 80% -h 40% -E "sh '$D/prompt.sh'" 2>/dev/null &
    pop=$!
    exec 3<>"$D/pass"   # open rw so open() never blocks
    pass=
    while :; do
        IFS= read -r -t 1 -u 3 pass && break
        if ! kill -0 "$pop" 2>/dev/null; then
            # popup closed (Esc?); one last read against a timing race
            IFS= read -r -t 1 -u 3 pass && break
            exit 1
        fi
    done
    [ -n "$pass" ] || exit 1
    printf '%s' "$pass"
    exit 0
fi

# Fallback: resident agent in a terminal (sudo-tty-agent)
D=$RT/sudo-tty-agent
if [ -p "$D/req" ]; then
    # Agent protocol: line 1 = command, line 2 = justification (one line)
    printf '%s\n%s\n' "${CMD:-unknown command}" \
        "$(printf '%s' "$REASON" | tr '\n' ' ')" > "$D/req"
    IFS= read -r pass < "$D/resp"
    printf '%s' "$pass"
    exit 0
fi
echo "askpass: no tmux client and no sudo-tty-agent running" >&2
exit 1
