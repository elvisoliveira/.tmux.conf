#!/usr/bin/env bash

# Print current keyboard layout for tmux status bar.
# Wayland (sway) -> X11 (setxkbmap) -> TTY state file -> vconsole default.

set -uo pipefail

# Detect sway by process, not by env: tmux can outlive a sway session and
# inherit a stale SWAYSOCK after sway is restarted under a new socket path.
sway_pid="$(pgrep -x sway 2>/dev/null | head -n 1)"
if [ -n "$sway_pid" ]; then
  export SWAYSOCK="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/sway-ipc.$(id -u).${sway_pid}.sock"
  # Sway exposes long names like "English (US)" / "Portuguese (Brazil)".
  # Extract the country (parenthesized) and truncate to 2 chars: US, BR, UK.
  swaymsg -t get_inputs -r 2>/dev/null \
    | jq -r '.[] | select(.type=="keyboard") | .xkb_active_layout_name' \
    | head -n 1 \
    | sed -E 's/.*\(([^)]+)\).*/\1/' \
    | cut -c1-2 \
    | tr '[:lower:]' '[:upper:]'
  exit 0
fi

if [ -n "${DISPLAY:-}" ] && command -v setxkbmap >/dev/null 2>&1; then
  setxkbmap -query 2>/dev/null | awk '/layout:/ { print toupper($2); exit }'
  exit 0
fi

state_file="${XDG_RUNTIME_DIR:-/tmp}/tty-kbd-layout"
if [ -r "$state_file" ]; then
  tr '[:lower:]' '[:upper:]' < "$state_file"
else
  localectl status 2>/dev/null | awk '/VC Keymap:/ { print toupper($3); exit }'
fi
