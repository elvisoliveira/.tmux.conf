#!/bin/sh
# Agente de senha para sudo -A: rode num terminal seu e deixe em primeiro plano.
# Quando o Claude rodar sudo, o comando exato e o prompt de senha aparecem AQUI;
# a senha vai por FIFO (0600) direto ao sudo, sem passar pelo Claude.
D=${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/sudo-tty-agent
mkdir -p -m700 "$D"
rm -f "$D/req" "$D/resp"
mkfifo -m600 "$D/req" "$D/resp"
trap 'stty echo 2>/dev/null; rm -rf "$D"; exit 0' INT TERM EXIT
echo "[sudo-tty-agent] aguardando pedidos de senha (Ctrl+C para sair)"
while :; do
    # Protocolo: linha 1 = comando, linha 2 = justificativa (opcional). As duas
    # leituras na mesma redirecao — fechar o FIFO entre elas descartaria a 2a.
    { IFS= read -r cmd; IFS= read -r reason; } < "$D/req"
    [ -n "$cmd" ] || continue
    printf '\n[sudo-tty-agent] Autorizando execucao de:\n    %s\n' "$cmd"
    if [ -n "$reason" ]; then
        printf '[sudo-tty-agent] Justificativa (informada pelo agente, nao verificada):\n    %s\n' "$reason"
    fi
    printf 'Senha: '
    stty -echo
    IFS= read -r pass
    stty echo
    printf '\n'
    printf '%s\n' "$pass" > "$D/resp"
    pass=
done
