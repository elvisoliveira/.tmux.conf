#!/usr/bin/env bash
# tmux-git-list — left pane of tmux-git.
#
# Lists the working-tree files in fzf. On every selection change (`focus` event,
# and also on `start`) it writes the focused file's PATH to the fifo, which the
# diff pane consumes. On fzf exit it kills the diff pane and removes the fifo.
#
# Env (via `tmux ... -e`): GIT_ROOT, FIFO, DIFF_PANE.
#
# The path is the second field, TAB-separated, so names with spaces survive;
# renames (`old -> new`) use the destination.
set -uo pipefail

cd "$GIT_ROOT"

trap 'tmux kill-pane -t "$DIFF_PANE" 2>/dev/null; rm -f "$FIFO"' EXIT

push='printf "%s\n" {2} > "$FIFO"'

git -c core.quotepath=false status --porcelain=v1 \
  | while IFS= read -r line; do
      st=${line:0:2}
      path=${line:3}
      case "$path" in *" -> "*) path=${path#* -> } ;; esac
      printf '%s\t%s\n' "$st" "$path"
    done \
  | fzf --ansi --reverse --delimiter '\t' --with-nth '1,2' \
        --header 'j/k: navigate · enter/esc: quit' \
        --bind "start:execute-silent($push)" \
        --bind "focus:execute-silent($push)" \
        >/dev/null || true
