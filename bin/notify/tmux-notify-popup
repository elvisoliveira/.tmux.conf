#!/usr/bin/env bash
# tmux-notify-popup — render ONE libnotify notification as an auto-closing
# floating toast in tmux, colored by urgency. Reads a single tiramisu --json
# object on stdin. Driven by tmux-notifyd; can also be tested by hand:
#
#   echo '{"source":"build","summary":"Done","body":"3 passed","hints":{"urgency":"0x02"}}' \
#       | ~/.env/.tmux.conf/bin/notify/tmux-notify-popup
#
# tmux options (set -g):
#   @notify-popup-duration   seconds the toast stays up      (default 4)
#
# The toast is a floating pane (new-pane, tmux >= 3.7): non-modal, never steals
# the keyboard. With -A (tmux >= 3.8) it floats above a zoomed window too.
set -u

DUR=$(tmux show-option -gqv @notify-popup-duration 2>/dev/null)
case "$DUR" in ''|*[!0-9]*) DUR=4 ;; esac

RUNTIME="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"

# Parse the notification: four trimmed fields, NUL-separated (a body may span
# lines), straight into variables. Nothing is eval'd.
{ IFS= read -r -d '' SRC; IFS= read -r -d '' SUMM; IFS= read -r -d '' BODY; IFS= read -r -d '' URG; } < <(
    jq -j '[.source, .summary, .body, (.hints.urgency // "" | tostring)]
           | map((. // "") | tostring | gsub("^\\s+|\\s+$"; "") | gsub("\u0000"; ""))
           | join("\u0000") + "\u0000"' 2>/dev/null
)
[ -n "$SUMM$BODY" ] || exit 0

# Border color by urgency (0x02 = critical -> red, otherwise -> blue).
case "$URG" in
    0x02|2) bstyle="fg=colour160" ;;
    *)      bstyle="fg=colour39"  ;;
esac

# Title (border) = the notification SUMMARY, i.e. the notify-send title. The app
# name is prefixed only when set and not libnotify's generic "notify-send".
case "$SRC" in
    ''|notify-send) title=" 🔔 $SUMM " ;;
    *)              title=" 🔔 $SRC · $SUMM " ;;
esac

# Body goes through a temp file (it may hold newlines/quotes), written WITHOUT
# a trailing newline so a short pane does not scroll it out of view.
tmpf="$RUNTIME/tmux-notify.$$"
printf '%s' "${BODY:- }" > "$tmpf"
blines=$(awk 'END{print NR}' "$tmpf"); [ "${blines:-0}" -lt 1 ] && blines=1

# Geometry, clamped. Width tracks the wider of title and body; +6 pads borders
# and wide glyphs. Height = body lines + 2 rows of chrome.
maxc=${#title}; [ "${#BODY}" -gt "$maxc" ] && maxc=${#BODY}
w=$((maxc + 6)); [ "$w" -lt 24 ] && w=24; [ "$w" -gt 64 ] && w=64
h=$((blines + 2))

# Render on EVERY live tmux server with an attached client, discovered by
# scanning the socket dir (a daemon has no $TMUX). One toast per client window,
# top-right. For new-pane, -x/-y are the SIZE and -X/-Y the POSITION.
SOCKDIR="${TMUX_TMPDIR:-/tmp}/tmux-$(id -u)"
TAB=$'\t'
for sock in "$SOCKDIR"/*; do
    [ -S "$sock" ] || continue
    # -A (>= 3.8) keeps a zoomed window zoomed under the toast; without it the
    # float still works but unzooms. Probe per server, they may differ.
    above=; tmux -S "$sock" list-commands new-pane 2>/dev/null | grep -q '\[-A' && above=-A
    tmux -S "$sock" list-clients \
        -F "#{session_name}:#{window_index}${TAB}#{window_width}" 2>/dev/null \
    | while IFS="$TAB" read -r tgt ww; do
        [ -n "$tgt" ] || continue
        x=$(( ${ww:-80} - w - 1 )); [ "$x" -lt 0 ] && x=0
        tmux -S "$sock" new-pane $above -d -t "$tgt" -x "$w" -y "$h" -X "$x" -Y 1 \
            -S "$bstyle" -R "$bstyle" -T "$title" "cat '$tmpf'; sleep $DUR" >/dev/null 2>&1
    done
done

# Remove the temp file once the toast has closed.
( sleep $((DUR + 1)); rm -f "$tmpf" ) >/dev/null 2>&1 &
