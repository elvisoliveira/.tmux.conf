#!/usr/bin/env bash
# tmux-git-pane <kind> — renders ONE quadrant of the nested dashboard.
#
#   worktree  fzf of changed files; navigating pushes "file\t<path>" to the fifo
#   log       fzf of commits;       navigating pushes "commit\t<hash>" to the fifo
#   branches  fzf of branches + tags; navigating pushes "commit\t<ref>" (git show)
#   diff      fifo reader: renders the file's diff / the commit's `git show`
#
# The diff pane is the shared "detail view": it reflects the last thing you moved
# through in the working tree OR the log. Env: GIT_ROOT, GIT_FIFO.
#
# Three levels of navigation:
#   lowercase h/j/k/l  -> type into the fzf filter (case-insensitive, -i)
#   Shift  H/J/K/L     -> move the LIST (J/K down/up, H/L top/bottom). Since the
#                         filter ignores case, uppercase isn't needed for typing,
#                         so it is repurposed for navigation.
#   Ctrl   C-h/j/k/l   -> switch PANE (binding of the nested tmux)
# Also: arrows and Ctrl+d/u (half-page) move the list. Esc/Enter/Ctrl-C are
# ignored so fzf never quits on its own (the tmux C-q is what quits); if it quits
# anyway, `tail` keeps the pane alive. The hints live only in the tmux status bar.
set -uo pipefail

BIN="$(dirname "$(readlink -f "$0")")"
cd "${GIT_ROOT:-.}"
FIFO="${GIT_FIFO:-}"

# fzf grabs the mouse by itself (independent of tmux's mouse option); the panel
# is keyboard-driven, so disable it for every fzf below in one place.
export FZF_DEFAULT_OPTS="${FZF_DEFAULT_OPTS:-} --no-mouse"

FZF_NAV='J:down,K:up,H:first,L:last,ctrl-d:half-page-down,ctrl-u:half-page-up'
FZF_KEEP='esc:ignore,enter:ignore,ctrl-c:ignore,ctrl-g:ignore,ctrl-q:ignore'

case "${1:-worktree}" in
  worktree)
    # Interactive, FILTERABLE directory tree. --disabled: fzf does NOT filter the
    # query itself — instead each keystroke reloads tmux-git-worktree {q}, which
    # re-renders a real TREE of just the matches (with their parent dirs), so it
    # never collapses to a flat list. Type (lowercase) to filter; ⇧J/K/H/L
    # navigate (FZF_NAV — letters stay free for typing, like the log pane).
    # Row = "<tree>\t<path>" (--with-nth 1 shows the tree, path rides hidden);
    # moving to a FILE row pushes it to the fifo so the diff follows, dir rows
    # (empty path) are skipped. --gutter/--info/--no-scrollbar drop the chrome.
    # Push via the tmux-git-push helper (a bash script), NOT an inline bind:
    # fzf runs binds through $SHELL, which may be fish — and fish can't parse
    # bash var-assignment/guards. {2} is the hidden path (empty for dir rows).
    "$BIN/tmux-git-worktree" \
      | fzf --ansi --reverse --no-mouse --delimiter '\t' --with-nth 1 \
            --disabled --prompt='filter: ' \
            --info=hidden --no-scrollbar --gutter=' ' --pointer='▶' \
            --bind "change:reload($BIN/tmux-git-worktree {q})+first" \
            --bind "$FZF_NAV" --bind "$FZF_KEEP" \
            --bind "start:execute-silent($BIN/tmux-git-push file {2})" \
            --bind "focus:execute-silent($BIN/tmux-git-push file {2})" \
            >/dev/null 2>&1 || true
    exec tail -f /dev/null
    ;;

  log)
    # tmux-git-log renders the content: hash · date · author · refs (subject lives
    # only in the diff pane). No query -> a --graph tree; typing -> a flat filtered
    # list (--disabled + change:reload, so filtering never orphans graph glyphs —
    # same model as the worktree pane). The hash isn't a fixed fzf field (a graph
    # glyph may precede it), so the focus bind passes the whole line {} and
    # tmux-git-push digs the hash out.
    "$BIN/tmux-git-log" \
      | fzf --ansi --reverse --no-mouse --disabled --prompt='filter: ' --info=inline \
            --bind "change:reload($BIN/tmux-git-log {q})+first" \
            --bind "$FZF_NAV" --bind "$FZF_KEEP" \
            --bind "focus:execute-silent($BIN/tmux-git-push commit {} log)" \
            >/dev/null 2>&1 || true
    exec tail -f /dev/null
    ;;

  branches|tags)
    # fzf table (same model as the log). Row: ref · tip hash · date (no subject —
    # that's in the diff pane). The ref name is the uncolored 1st token, so {1}
    # extracts cleanly; navigating pushes it as a "commit" so the diff runs
    # `git show <ref>` on its tip. Newest first. branches = refs/heads, tags =
    # refs/tags (own panes, own fifo source).
    case "$1" in branches) refs=refs/heads ;; tags) refs=refs/tags ;; esac
    git for-each-ref --sort=-creatordate --color=always "$refs" \
        --format='%(align:20,left)%(refname:short)%(end) %(color:dim)%(objectname:short) %(committerdate:format:%Y-%m-%d)%(color:reset)' \
      | fzf --ansi -i --reverse --no-mouse --prompt='filter: ' --info=inline \
            --bind "$FZF_NAV" --bind "$FZF_KEEP" \
            --bind "focus:execute-silent($BIN/tmux-git-push commit {1} $1)" \
            >/dev/null 2>&1 || true
    exec tail -f /dev/null
    ;;

  diff)
    if [ -z "$FIFO" ]; then echo '  (no fifo)'; exec tail -f /dev/null; fi
    # read+write on fd 3: read blocks waiting for data (no EOF) and the writers
    # (fzf) never stall.
    exec 3<>"$FIFO"

    # delta sizes itself to the pane's own tty, so every render fills 100% of the
    # diff pane — no --width to get wrong. Static output can't reflow on its own,
    # so poll THIS pane's width (-t $TMUX_PANE, not the active pane) and re-render
    # the current item only when it actually changes, e.g. after a C-z zoom.
    typ=seed arg='' w=''
    render() {
      tmux send-keys -t "$TMUX_PANE" -X cancel 2>/dev/null   # leave copy-mode (if any) so new output shows live
      # In-band clear of screen AND scrollback (CSI 3 J): rides the same pty
      # stream as the diff output below, so ordering is exact even while a slow
      # previous render is still draining. `tmux clear-history` (command
      # channel) raced the pty and left the old diff stacked above the new one
      # — history-top then opened on stale content instead of this render.
      printf '\033[H\033[2J\033[3J'
      case "$typ" in
        commit) git show --color=always "$arg" 2>/dev/null ;;
        file)
          if git ls-files --error-unmatch -- "$arg" >/dev/null 2>&1
            then d=$(git diff HEAD -- "$arg" 2>/dev/null); [ -n "$d" ] || d=$(git diff -- "$arg" 2>/dev/null); printf '%s\n' "$d"
            else git diff --no-index -- /dev/null "$arg" 2>/dev/null
          fi ;;
        *) d=$(git diff HEAD 2>/dev/null); [ -n "$d" ] || d=$(git diff 2>/dev/null)
           # Clean working tree -> seed with the newest commit (top of the log).
           if [ -n "$d" ]; then printf '%s\n' "$d"; else git show --color=always HEAD 2>/dev/null; fi ;;
      esac | delta --paging=never --side-by-side --wrap-max-lines 0
      # A diff taller than the pane auto-scrolls the view to the bottom; drop into
      # copy-mode at the top so it always opens at the start of the diff. Scroll
      # keys (C-j/C-k, ⇧J/K, C-d/C-u) work from copy-mode; prefix/C-w still switch.
      # First wait for the pty stream to settle (two identical readings 50ms
      # apart): copy-mode/history-top go through the command channel and would
      # otherwise race the still-draining output above.
      hs_prev=
      for _ in $(seq 20); do
        hs_cur=$(tmux display -p -t "$TMUX_PANE" '#{history_size}.#{cursor_y}' 2>/dev/null)
        [ "$hs_cur" = "$hs_prev" ] && break
        hs_prev=$hs_cur; sleep 0.05
      done
      tmux copy-mode -t "$TMUX_PANE" 2>/dev/null
      tmux send-keys -t "$TMUX_PANE" -X history-top 2>/dev/null
    }
    render
    # The fifo carries only wakeup pokes; the selection itself lives in the
    # $FIFO.cur state file (written atomically by tmux-git-push). Rendering only
    # the newest state skips the backlog when navigation outruns delta, and a
    # lost/coalesced poke self-heals on the next 0.5s poll.
    last=''
    while :; do
      IFS= read -t 0.5 -r _ <&3
      while IFS= read -t 0.01 -r _ <&3; do :; done   # drain extra pokes
      cur=$(cat "$FIFO.cur" 2>/dev/null)
      if [ -n "$cur" ] && [ "$cur" != "$last" ]; then
        last=$cur; typ=${cur%%$'\t'*}; arg=${cur#*$'\t'}
        render
        continue
      fi
      nw=$(tmux display -p -t "$TMUX_PANE" '#{pane_width}' 2>/dev/null)
      [ "$nw" = "$w" ] || { render; w=$nw; }
    done
    ;;

  *)
    echo "unknown kind: $1"; exec tail -f /dev/null
    ;;
esac
