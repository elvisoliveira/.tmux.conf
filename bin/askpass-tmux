#!/usr/bin/env bash
# SUDO_ASKPASS: pede a senha numa floating pane (display-popup) do tmux, sob
# demanda — sem agente residente. Mostra o comando real do sudo (lido de /proc
# do processo pai). A senha vai por FIFO 0600 em tmpfs direto ao sudo.
# Fallback: sudo-tty-agent (se estiver rodando); senao, falha com aviso.
set -u
CMD=$(tr '\0' ' ' < /proc/$PPID/cmdline 2>/dev/null | tr -d '\n')
RT=${XDG_RUNTIME_DIR:-/run/user/$(id -u)}

# Justificativa autodeclarada pelo agente em $RT/sudo-reason (consumo unico;
# ignorada se tiver mais de 60s, para nunca exibir sobra de invocacao antiga).
# NAO e verificada — a linha autoritativa e sempre o comando lido de /proc.
REASON=
if [ -f "$RT/sudo-reason" ]; then
    mt=$(stat -c %Y "$RT/sudo-reason" 2>/dev/null || echo 0)
    [ $(( $(date +%s) - mt )) -le 60 ] && REASON=$(head -c 600 "$RT/sudo-reason" | head -n 8)
    rm -f "$RT/sudo-reason"
fi

# Cliente tmux mais recentemente ativo recebe o popup
client=$(tmux list-clients -F '#{client_activity} #{client_name}' 2>/dev/null \
         | sort -rn | awk 'NR==1{print $2}')

if [ -n "$client" ]; then
    D=$(mktemp -d "$RT/sudo-ask.XXXXXX") || exit 1
    mkfifo -m600 "$D/pass" || { rm -rf "$D"; exit 1; }
    trap 'rm -rf "$D"' EXIT
    printf '%s' "${CMD:-comando desconhecido}" > "$D/cmd"
    printf '%s' "$REASON" > "$D/reason"
    # O comando vai por arquivo (nada de interpolar conteudo em shell); o
    # prompt.sh nunca contem a senha. Comando primeiro (autoritativo),
    # justificativa depois, ja truncada — para nao empurrar o comando da tela.
    cat > "$D/prompt.sh" <<EOF
#!/bin/sh
printf '\\033[1mAutorizando execucao de:\\033[0m\n\n    %s\n\n' "\$(cat '$D/cmd')"
if [ -s '$D/reason' ]; then
    printf '\\033[2mJustificativa (informada pelo agente, nao verificada):\\033[0m\n'
    sed 's/^/    /' '$D/reason'
    printf '\n\n'
fi
printf 'Senha (Esc cancela): '
stty -echo 2>/dev/null
IFS= read -r p
stty echo 2>/dev/null
printf '\n'
printf '%s\n' "\$p" > '$D/pass'
EOF
    tmux display-popup -c "$client" -T ' sudo ' -w 80% -h 40% -E "sh '$D/prompt.sh'" 2>/dev/null &
    pop=$!
    exec 3<>"$D/pass"   # abre rw para nunca bloquear no open()
    pass=
    while :; do
        IFS= read -r -t 1 -u 3 pass && break
        if ! kill -0 "$pop" 2>/dev/null; then
            # popup fechou (Esc?); ultima chance contra corrida de timing
            IFS= read -r -t 1 -u 3 pass && break
            exit 1
        fi
    done
    [ -n "$pass" ] || exit 1
    printf '%s' "$pass"
    exit 0
fi

# Fallback: agente residente no terminal (sudo-tty-agent.sh)
D=$RT/sudo-tty-agent
if [ -p "$D/req" ]; then
    # Protocolo do agente: linha 1 = comando, linha 2 = justificativa (1 linha)
    printf '%s\n%s\n' "${CMD:-comando desconhecido}" \
        "$(printf '%s' "$REASON" | tr '\n' ' ')" > "$D/req"
    IFS= read -r pass < "$D/resp"
    printf '%s' "$pass"
    exit 0
fi
echo "askpass: sem cliente tmux e sem sudo-tty-agent rodando" >&2
exit 1
