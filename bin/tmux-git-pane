#!/usr/bin/env bash
# tmux-git-pane <kind> — renders ONE quadrant of the nested dashboard.
#
#   worktree  fzf of changed files; navigating pushes "file\t<path>" to the fifo
#   log       fzf of commits;       navigating pushes "commit\t<hash>" to the fifo
#   branches  fzf of branches + tags; navigating pushes "commit\t<ref>" (git show)
#   diff      fifo reader: renders the file's diff / the commit's `git show`
#
# The diff pane is the shared "detail view": it reflects the last thing you moved
# through in the working tree OR the log. Env: GIT_ROOT, GIT_FIFO.
#
# Three levels of navigation:
#   lowercase h/j/k/l  -> type into the fzf filter (case-insensitive, -i)
#   Shift  H/J/K/L     -> move the LIST (J/K down/up, H/L top/bottom). Since the
#                         filter ignores case, uppercase isn't needed for typing,
#                         so it is repurposed for navigation.
#   Ctrl   C-h/j/k/l   -> switch PANE (binding of the nested tmux)
# Also: arrows and Ctrl+d/u (half-page) move the list. Esc/Enter/Ctrl-C are
# ignored so fzf never quits on its own (the tmux C-q is what quits); if it quits
# anyway, `tail` keeps the pane alive. The hints live only in the tmux status bar.
set -uo pipefail

BIN="$(dirname "$(readlink -f "$0")")"
cd "${GIT_ROOT:-.}"
FIFO="${GIT_FIFO:-}"

FZF_NAV='J:down,K:up,H:first,L:last,ctrl-d:half-page-down,ctrl-u:half-page-up'
FZF_KEEP='esc:ignore,enter:ignore,ctrl-c:ignore,ctrl-g:ignore'

case "${1:-worktree}" in
  worktree)
    # Interactive, FILTERABLE directory tree. --disabled: fzf does NOT filter the
    # query itself — instead each keystroke reloads tmux-git-worktree {q}, which
    # re-renders a real TREE of just the matches (with their parent dirs), so it
    # never collapses to a flat list. Type (lowercase) to filter; ⇧J/K/H/L
    # navigate (FZF_NAV — letters stay free for typing, like the log pane).
    # Row = "<tree>\t<path>" (--with-nth 1 shows the tree, path rides hidden);
    # moving to a FILE row pushes it to the fifo so the diff follows, dir rows
    # (empty path) are skipped. --gutter/--info/--no-scrollbar drop the chrome.
    # Push via the tmux-git-push helper (a bash script), NOT an inline bind:
    # fzf runs binds through $SHELL, which may be fish — and fish can't parse
    # bash var-assignment/guards. {2} is the hidden path (empty for dir rows).
    "$BIN/tmux-git-worktree" \
      | fzf --ansi --reverse --delimiter '\t' --with-nth 1 \
            --disabled --prompt='filter: ' \
            --info=hidden --no-scrollbar --gutter=' ' --pointer='▶' \
            --bind "change:reload($BIN/tmux-git-worktree {q})+first" \
            --bind "$FZF_NAV" --bind "$FZF_KEEP" \
            --bind "start:execute-silent($BIN/tmux-git-push file {2})" \
            --bind "focus:execute-silent($BIN/tmux-git-push file {2})" \
            >/dev/null 2>&1 || true
    exec tail -f /dev/null
    ;;

  log)
    # Table: hash (pad 9) · date (YYYY-MM-DD) · subject truncated to 50 cols · refs.
    # Fixed columns align; only the last (refs) is variable. The hash stays
    # uncolored as the 1st token, so {1} extracts cleanly for `git show`.
    push='printf "commit\t%s\n" {1} > "$GIT_FIFO"'
    git -c color.ui=always log --color=always --date=format:'%Y-%m-%d' \
        --pretty=format:'%<(9)%h %C(dim)%ad%C(reset)  %<(50,trunc)%s %C(auto)%d%C(reset)' -n 300 \
      | fzf --ansi -i --reverse \
            --bind "$FZF_NAV" --bind "$FZF_KEEP" \
            --bind "focus:execute-silent($push)" \
            >/dev/null 2>&1 || true
    exec tail -f /dev/null
    ;;

  branches)
    # fzf table of branches + tags (same model as the log). Row: ref · tip hash ·
    # date · subject. The ref name is the uncolored 1st token, so {1} extracts
    # cleanly; navigating pushes it as a "commit" so the diff runs `git show <ref>`
    # on its tip. Newest first, branches and tags mixed by date.
    git for-each-ref --sort=-creatordate --color=always refs/heads refs/tags \
        --format='%(align:20,left)%(refname:short)%(end) %(color:dim)%(objectname:short) %(committerdate:format:%Y-%m-%d)%(color:reset) %(contents:subject)' \
      | fzf --ansi -i --reverse \
            --bind "$FZF_NAV" --bind "$FZF_KEEP" \
            --bind "focus:execute-silent($BIN/tmux-git-push commit {1} branches)" \
            >/dev/null 2>&1 || true
    exec tail -f /dev/null
    ;;

  diff)
    if [ -z "$FIFO" ]; then echo '  (no fifo)'; exec tail -f /dev/null; fi
    # read+write on fd 3: read blocks waiting for data (no EOF) and the writers
    # (fzf) never stall.
    exec 3<>"$FIFO"
    clear; tmux clear-history 2>/dev/null
    # Seed with the whole working-tree diff (the tree pane is now a static
    # overview and no longer drives this). The log pane can override it with a
    # commit's `git show`.
    d=$(git diff HEAD 2>/dev/null); [ -n "$d" ] || d=$(git diff 2>/dev/null)
    if [ -n "$d" ]; then printf '%s\n' "$d" | delta --paging=never; else echo '  (clean working tree)'; fi
    while IFS= read -r line <&3; do
      [ -n "$line" ] || continue
      typ=${line%%$'\t'*}; arg=${line#*$'\t'}
      # Drop the previous diff from the scrollback so copy-mode (PageUp) scrolls
      # only THIS diff — g/G and page-up then stay within it, not old renders.
      clear; tmux clear-history 2>/dev/null
      case "$typ" in
        file)
          if git ls-files --error-unmatch -- "$arg" >/dev/null 2>&1; then
            d=$(git diff HEAD -- "$arg" 2>/dev/null); [ -n "$d" ] || d=$(git diff -- "$arg" 2>/dev/null)
          else
            d=$(git diff --no-index -- /dev/null "$arg" 2>/dev/null || true)
          fi
          if [ -n "$d" ]; then printf '%s\n' "$d" | delta --paging=never; else echo '  (no changes)'; fi
          ;;
        commit)
          git show --color=always "$arg" 2>/dev/null | delta --paging=never
          ;;
      esac
    done
    ;;

  *)
    echo "unknown kind: $1"; exec tail -f /dev/null
    ;;
esac
